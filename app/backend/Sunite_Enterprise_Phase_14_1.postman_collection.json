          "host": ["{{baseUrl}}"],
          "path": ["api", "v1", "pilot", "security-audit"]
        }
      }
    },
    {
      "name": "6. Verify Backup & Disaster Recovery Status",
      "request": {
        "method": "GET",
        "header": [],
        "url": {
          "raw": "{{baseUrl}}/api/v1/pilot/backup-status",
          "host": ["{{baseUrl}}"],
          "path": ["api", "v1", "pilot", "backup-status"]
        }
      }
    },
    {
      "name": "7. Get Realtime Health Dashboard Telemetry",
      "request": {
        "method": "GET",
        "header": [],
        "url": {
          "raw": "{{baseUrl}}/api/v1/pilot/health-dashboard",
          "host": ["{{baseUrl}}"],
