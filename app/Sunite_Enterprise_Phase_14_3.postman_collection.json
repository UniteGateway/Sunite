{
  "info": {
    "name": "Sunite Enterprise Phase 14.3 - Enterprise Operations Center (NOC/SOC)",
    "description": "Postman API Collection for Sunite Enterprise Phase 14.3 REST APIs including Global Dashboard, Component Health, Incidents, Security SOC, Backups & DR, Capacity, and SLA Report.",
