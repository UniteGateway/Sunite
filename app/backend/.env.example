# ====================================================
# SUNITE ENTERPRISE BACKEND - ENVIRONMENT CONFIGURATION
# ====================================================

# APPLICATION ENVIRONMENT
NODE_ENV=development
PORT=3000
HOST=0.0.0.0
APP_NAME=Sunite Enterprise Backend
API_PREFIX=api/v1

# POSTGRESQL DATABASE
POSTGRES_HOST=localhost
POSTGRES_PORT=5432
POSTGRES_USER=sunite_admin
POSTGRES_PASSWORD=SuniteSecurePass2026!
POSTGRES_DB=sunite_enterprise_db
DATABASE_URL=postgresql://${POSTGRES_USER}:${POSTGRES_PASSWORD}@${POSTGRES_HOST}:${POSTGRES_PORT}/${POSTGRES_DB}?schema=public&connection_limit=20&pool_timeout=30

# REDIS CACHE & SESSION STORE
REDIS_HOST=localhost
REDIS_PORT=6379
REDIS_PASSWORD=SuniteRedisPass2026!
REDIS_DB=0
REDIS_TTL_SECONDS=3600

# AUTHENTICATION & SECURITY (JWT)
JWT_SECRET=sunite_enterprise_super_secret_jwt_key_2026_xyz_789!
JWT_EXPIRATION=15m
JWT_REFRESH_SECRET=sunite_enterprise_refresh_token_secret_2026_abc_456!
JWT_REFRESH_EXPIRATION=7d
PASSWORD_SALT_ROUNDS=12

# SWAGGER API DOCS
SWAGGER_ENABLED=true
SWAGGER_PATH=docs

# SECURITY & RATE LIMITING
THROTTLE_TTL=60
THROTTLE_LIMIT=120
CORS_ORIGINS=https://sunite.com,https://app.sunite.com
