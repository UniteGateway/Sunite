{
  "info": {
    "name": "Sunite Enterprise Phase 15.0 - Open Platform & Marketplace",
    "description": "Postman API Collection for Sunite Enterprise Phase 15.0 REST APIs including Developer Registration, API Key Generation, Developer Apps, Plugin Management, Marketplace Apps, Directory, and Public API Catalog.",
    "schema": "https://schema.getpostman.com/json/collection/v2.1.0/collection.json"
  },
  "item": [
    {
      "name": "Register Developer Organization",
      "request": {
        "method": "POST",
        "header": [{ "key": "Content-Type", "value": "application/json" }],
        "body": {
          "mode": "raw",
          "raw": "{\n  \"orgName\": \"Sungrow Power Solutions\",\n  \"email\": \"api-support@sungrowpower.com\",\n  \"tier\": \"TIER_OEM\"\n}"
        },
        "url": {
          "raw": "{{baseUrl}}/api/v1/developers/register",
          "host": ["{{baseUrl}}"],
          "path": ["api", "v1", "developers", "register"]
        }
      }
    },
    {
      "name": "Generate Developer API Key",
      "request": {
        "method": "POST",
