# SUNITE ENTERPRISE - PRODUCTION ENVIRONMENT TEMPLATE

NODE_ENV=production
PORT=3000

# DATABASE CONFIGURATION
DATABASE_URL="postgresql://sunite_user:SecurePass2026!@postgres-prod.sunite.internal:5432/sunite_db?schema=public&sslmode=require&connection_limit=50"
DB_USER=sunite_user
DB_PASSWORD=SecurePass2026!
DB_NAME=sunite_db

# REDIS CACHE & QUEUE
REDIS_URL="redis://:RedisPass2026!@redis-prod.sunite.internal:6379"
REDIS_PASSWORD=RedisPass2026!

# SECURITY & AUTH
JWT_SECRET=sunite_enterprise_production_jwt_secret_key_2026_super_secure
JWT_EXPIRATION=1d
REFRESH_TOKEN_SECRET=sunite_enterprise_refresh_token_secret_key_2026

# CLOUD & AWS / AZURE
AWS_REGION=ap-south-1
S3_BUCKET_NAME=sunite-enterprise-documents-prod
AZURE_STORAGE_ACCOUNT=sunitedata

# AI PROVIDER KEYS
GEMINI_API_KEY=AIzaSy_production_gemini_key_sample
OPENAI_API_KEY=sk-prod-sample-key
