        "header": [
          { "key": "Content-Type", "value": "application/json" }
        ],
        "body": {
          "mode": "raw",
          "raw": "{\n  \"reportName\": \"Q3 Commercial Solar Sales\",\n  \"entityType\": \"SALES\",\n  \"columns\": [\"Lead Source\", \"Deal Value\", \"Conversion Rate\", \"Executive\"],\n  \"chartType\": \"BAR\"\n}"
        },
