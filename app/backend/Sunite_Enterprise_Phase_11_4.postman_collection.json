{
  "info": {
    "name": "Sunite Enterprise - Phase 11.4 Organization & User Management API",
    "description": "Postman Collection for NestJS Organization, Branch, Department, and User REST APIs",
    "schema": "https://schema.getpostman.com/json/collection/v2.1.0/collection.json"
  },
  "item": [
    {
      "name": "Organizations",
      "item": [
        {
          "name": "Get All Organizations",
          "request": {
            "method": "GET",
            "url": { "raw": "{{baseUrl}}/api/v1/organizations?page=1&limit=10", "host": ["{{baseUrl}}"], "path": ["api", "v1", "organizations"] }
          }
        },
        {
          "name": "Create Organization",
          "request": {
            "method": "POST",
            "header": [{ "key": "Content-Type", "value": "application/json" }],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"companyName\": \"Sunite Energy Solutions Pvt Ltd\",\n  \"legalName\": \"Sunite Energy Global Limited\",\n  \"taxId\": \"27AABCS1234F1Z9\",\n  \"currency\": \"INR\",\n  \"status\": \"ACTIVE\"\n}"
            },
            "url": { "raw": "{{baseUrl}}/api/v1/organizations", "host": ["{{baseUrl}}"], "path": ["api", "v1", "organizations"] }
          }
        }
      ]
    },
    {
      "name": "Users",
      "item": [
        {
          "name": "Get All Users",
          "request": {
            "method": "GET",
            "url": { "raw": "{{baseUrl}}/api/v1/users?role=SOLAR_ENGINEER", "host": ["{{baseUrl}}"], "path": ["api", "v1", "users"] }
          }
        },
        {
          "name": "Create User",
          "request": {
            "method": "POST",
            "header": [{ "key": "Content-Type", "value": "application/json" }],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"organizationId\": \"{{orgId}}\",\n  \"email\": \"field.engineer@sunite.com\",\n  \"mobile\": \"+919876543299\",\n  \"password\": \"SunitePass2026!\",\n  \"firstName\": \"Rohan\",\n  \"lastName\": \"Verma\",\n  \"role\": \"FIELD_INSTALLER\"\n}"
            },
            "url": { "raw": "{{baseUrl}}/api/v1/users", "host": ["{{baseUrl}}"], "path": ["api", "v1", "users"] }
          }
        }
      ]
    }
  ]
}
