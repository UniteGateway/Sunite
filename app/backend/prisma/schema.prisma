// ====================================================
// SUNITE ENTERPRISE - MASTER POSTGRESQL PRISMA SCHEMA
// PHASE 11.3 - COMPLETE ENTERPRISE DATA MODEL
// ====================================================

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

// ==========================================
// ENUMS
// ==========================================

enum UserRole {
  SUPER_ADMIN
  ENTERPRISE_ADMIN
  BRANCH_MANAGER
  DEPARTMENT_HEAD
  PROJECT_MANAGER
  SOLAR_ENGINEER
  SURVEY_ENGINEER
  SALES_EXECUTIVE
  FIELD_INSTALLER
  FINANCE_AUDITOR
  PARTNER_MEMBER
  FRANCHISE_ADMIN
  EPC_CONTRACTOR
  CUSTOMER_USER
}

enum EntityStatus {
  ACTIVE
  INACTIVE
  PENDING
  SUSPENDED
  ARCHIVED
}

enum LeadStatus {
  NEW_INQUIRY
  CONTACTED
  SURVEY_SCHEDULED
  SURVEY_COMPLETED
  PROPOSAL_SENT
  CONTRACT_SIGNED
  LOST
  CONVERTED
}

enum ProjectStage {
  FEASIBILITY
  ENGINEERING_DESIGN
  PERMITTING
  PROCUREMENT
  CIVIL_WORK
  STRUCTURE_MOUNTING
  ELECTRICAL_WIRING
  INVERTER_GRID_SYNC
  COMMISSIONING
  HANDOVER_COMPLETED
}

enum OrderStatus {
  DRAFT
  SUBMITTED
  APPROVED
  IN_FULFILLMENT
  DISPATCHED
  DELIVERED
  CANCELLED
}

enum PaymentStatus {
  UNPAID
  PARTIALLY_PAID
  FULLY_PAID
  OVERDUE
  REFUNDED
}

enum ServiceTicketPriority {
  LOW
  MEDIUM
  HIGH
  CRITICAL
  EMERGENCY
}

enum TicketStatus {
  OPEN
  IN_PROGRESS
  PENDING_PARTS
  RESOLVED
  CLOSED
}

enum TelemetryType {
  SOLAR_GENERATION_KW
  GRID_EXPORT_KW
  BATTERY_SOC_PCT
  INVERTER_TEMP_C
  FAULT_ALARM
}

// ==========================================
// 1. ORGANIZATION & STRUCTURE
// ==========================================

model Organization {
  id           String       @id @default(uuid())
  companyName  String       @map("company_name")
  legalName    String       @map("legal_name")
  taxId        String       @unique @map("tax_id") // GSTIN / CIN
  currency     String       @default("INR")
  status       EntityStatus @default(ACTIVE)
  
  createdBy    String?      @map("created_by")
  updatedBy    String?      @map("updated_by")
  createdAt    DateTime     @default(now()) @map("created_at")
  updatedAt    DateTime     @updatedAt @map("updated_at")
  deletedAt    DateTime?    @map("deleted_at")

  branches     Branch[]
  departments  Department[]
  users        User[]
  customers    Customer[]
  partners     Partner[]
  projects     Project[]

  @@index([taxId])
  @@index([companyName])
  @@map("organizations")
}

model Branch {
  id             String       @id @default(uuid())
  organizationId String       @map("organization_id")
  branchCode     String       @unique @map("branch_code")
  branchName     String       @map("branch_name")
  city           String
  state          String
  postalCode     String       @map("postal_code")
  address        String
  status         EntityStatus @default(ACTIVE)

  createdBy      String?      @map("created_by")
  updatedBy      String?      @map("updated_by")
  createdAt      DateTime     @default(now()) @map("created_at")
  updatedAt      DateTime     @updatedAt @map("updated_at")
  deletedAt      DateTime?    @map("deleted_at")

  organization   Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  departments    Department[]
  users          User[]
  projects       Project[]

  @@index([branchCode])
  @@index([city, state])
  @@map("branches")
}

model Department {
  id             String       @id @default(uuid())
  organizationId String       @map("organization_id")
  branchId       String?      @map("branch_id")
  deptCode       String       @map("dept_code")
  deptName       String       @map("dept_name")
  status         EntityStatus @default(ACTIVE)

  createdAt      DateTime     @default(now()) @map("created_at")
  updatedAt      DateTime     @updatedAt @map("updated_at")
  deletedAt      DateTime?    @map("deleted_at")

  organization   Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  branch         Branch?      @relation(fields: [branchId], references: [id], onDelete: SetNull)
  users          User[]

  @@unique([organizationId, deptCode])
  @@map("departments")
}

// ==========================================
// 2. USERS, ROLES & PERMISSIONS
// ==========================================

model User {
  id               String       @id @default(uuid())
  organizationId   String       @map("organization_id")
  branchId         String?      @map("branch_id")
  departmentId     String?      @map("department_id")
  email            String       @unique
  mobile           String       @unique
  passwordHash     String       @map("password_hash")
  firstName        String       @map("first_name")
  lastName         String       @map("last_name")
  role             UserRole     @default(SOLAR_ENGINEER)
  status           EntityStatus @default(ACTIVE)
  mfaEnabled       Boolean      @default(false) @map("mfa_enabled")
  mfaSecret        String?      @map("mfa_secret")
  refreshTokenHash String?      @map("refresh_token_hash")
  lastLoginAt      DateTime?    @map("last_login_at")

  createdBy        String?      @map("created_by")
  updatedBy        String?      @map("updated_by")
  createdAt        DateTime     @default(now()) @map("created_at")
  updatedAt        DateTime     @updatedAt @map("updated_at")
  deletedAt        DateTime?    @map("deleted_at")

  organization     Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  branch           Branch?      @relation(fields: [branchId], references: [id], onDelete: SetNull)
  department       Department?  @relation(fields: [departmentId], references: [id], onDelete: SetNull)

  assignedLeads    Lead[]       @relation("AssignedLeads")
  assignedSurveys  Survey[]     @relation("SurveyorEngineers")
  managedProjects  Project[]    @relation("ProjectManagers")
  auditLogs        AuditLog[]
  notifications    Notification[]

  @@index([email])
  @@index([mobile])
  @@index([organizationId, role])
  @@map("users")
}

// ==========================================
// 3. CUSTOMERS, PARTNERS & VENDORS
// ==========================================

model Customer {
  id             String       @id @default(uuid())
  organizationId String       @map("organization_id")
  customerCode   String       @unique @map("customer_code")
  fullName       String       @map("full_name")
  email          String
  mobile         String
  gstin          String?      @map("gstin")
  city           String
  state          String
  sanctionedKw   Float        @default(10.0) @map("sanctioned_kw")
  status         EntityStatus @default(ACTIVE)

  createdAt      DateTime     @default(now()) @map("created_at")
  updatedAt      DateTime     @updatedAt @map("updated_at")
  deletedAt      DateTime?    @map("deleted_at")

  organization   Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  leads          Lead[]
  projects       Project[]
  serviceTickets ServiceTicket[]
  activities     Activity[]

  @@index([fullName])
  @@index([mobile])
  @@index([email])
  @@index([gstin])
  @@map("customers")
}

model Partner {
  id             String       @id @default(uuid())
  organizationId String       @map("organization_id")
  partnerCode    String       @unique @map("partner_code")
  companyName    String       @map("company_name")
  partnerType    String       @map("partner_type") // EPC, Franchise, Marketing, Vendor
  contactPerson  String       @map("contact_person")
  email          String
  mobile         String
  gstin          String?      @map("gstin")
  status         EntityStatus @default(ACTIVE)

  createdAt      DateTime     @default(now()) @map("created_at")
  updatedAt      DateTime     @updatedAt @map("updated_at")
  deletedAt      DateTime?    @map("deleted_at")

  organization   Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  commissions    Commission[]

  @@index([partnerCode])
  @@index([gstin])
  @@map("partners")
}

// ==========================================
// 4. LEADS, SURVEYS & SOLAR DESIGN
// ==========================================

model Lead {
  id             String     @id @default(uuid())
  leadNumber     String     @unique @map("lead_number")
  customerId     String     @map("customer_id")
  assignedUserId String?    @map("assigned_user_id")
  kwRequirement  Float      @map("kw_requirement")
  roofType       String     @map("roof_type")
  utilityCompany String     @map("utility_company")
  status         LeadStatus @default(NEW_INQUIRY)

  createdAt      DateTime   @default(now()) @map("created_at")
  updatedAt      DateTime   @updatedAt @map("updated_at")
  deletedAt      DateTime?  @map("deleted_at")

  customer       Customer   @relation(fields: [customerId], references: [id], onDelete: Cascade)
  assignedUser   User?      @relation("AssignedLeads", fields: [assignedUserId], references: [id], onDelete: SetNull)
  surveys        Survey[]
  quotations     Quotation[]
  activities     Activity[]

  @@index([leadNumber])
  @@index([status])
  @@map("leads")
}

model Survey {
  id             String    @id @default(uuid())
  surveyNumber   String    @unique @map("survey_number")
  leadId         String    @map("lead_id")
  engineerId     String?   @map("engineer_id")
  usableRoofArea Float     @default(0.0) @map("usable_roof_area")
  azimuthDeg     Float     @default(180.0) @map("azimuth_deg")
  tiltAngleDeg   Float     @default(20.0) @map("tilt_angle_deg")
  sanctionedLoad Float     @default(0.0) @map("sanctioned_load")
  shadingReport  String?   @map("shading_report")
  isFeasible     Boolean   @default(true) @map("is_feasible")

  status         String    @default("SCHEDULED") @map("status")
  latitude       Float?    @map("latitude")
  longitude      Float?    @map("longitude")
  roofType       String?   @map("roof_type")
  discom         String?   @map("discom")
  consumerNumber String?   @map("consumer_number")
  remarks        String?   @map("remarks")

  createdAt      DateTime  @default(now()) @map("created_at")
  updatedAt      DateTime  @updatedAt @map("updated_at")
  deletedAt      DateTime? @map("deleted_at")

  lead           Lead      @relation(fields: [leadId], references: [id], onDelete: Cascade)
  engineer       User?     @relation("SurveyorEngineers", fields: [engineerId], references: [id], onDelete: SetNull)
  designs        SolarDesign[]

  @@map("surveys")
}

model SolarDesign {
  id                    String    @id @default(uuid())
  designNumber          String    @unique @default(uuid()) @map("design_number")
  surveyId              String    @map("survey_id")
  designVersion         Int       @default(1) @map("design_version")
  status                String    @default("DRAFT") @map("status")
  systemCapacityKw      Float     @map("system_capacity_kw")
  dcCapacityKw          Float     @default(0.0) @map("dc_capacity_kw")
  acCapacityKw          Float     @default(0.0) @map("ac_capacity_kw")
  dcAcRatio             Float     @default(1.2) @map("dc_ac_ratio")
  moduleType            String    @map("module_type")
  moduleCount           Int       @map("module_count")
  inverterType          String    @map("inverter_type")
  inverterCount         Int       @map("inverter_count")
  performanceRatio      Float     @default(0.78) @map("performance_ratio")
  cufPercent            Float     @default(19.5) @map("cuf_percent")
  dailyGenerationKwh    Float     @default(0.0) @map("daily_generation_kwh")
  monthlyGenerationKwh  Float     @default(0.0) @map("monthly_generation_kwh")
  estimatedAnnualGenKwh Float     @map("estimated_annual_gen_kwh")
  co2ReductionTons      Float     @default(0.0) @map("co2_reduction_tons")
  treesSaved            Int       @default(0) @map("trees_saved")
  estimatedCost         Float     @default(0.0) @map("estimated_cost")
  subsidyAmount         Float     @default(0.0) @map("subsidy_amount")
  roiPercent            Float     @default(0.0) @map("roi_percent")
  paybackYears          Float     @default(0.0) @map("payback_years")
  boqJson               String?   @map("boq_json")
  remarks               String?   @map("remarks")

  createdAt             DateTime  @default(now()) @map("created_at")
  updatedAt             DateTime  @updatedAt @map("updated_at")
  deletedAt             DateTime? @map("deleted_at")

  survey                Survey    @relation(fields: [surveyId], references: [id], onDelete: Cascade)

  @@map("solar_designs")
}

// ==========================================
// 5. QUOTATIONS, ORDERS & FINANCES
// ==========================================

model Quotation {
  id             String     @id @default(uuid())
  quotationNumber String    @unique @map("quotation_number")
  leadId         String     @map("lead_id")
  totalKw        Float      @map("total_kw")
  baseAmount     Float      @map("base_amount")
  gstAmount      Float      @map("gst_amount")
  subsidyAmount  Float      @default(0.0) @map("subsidy_amount")
  netAmount      Float      @map("net_amount")
  isApproved     Boolean    @default(false) @map("is_approved")

  createdAt      DateTime   @default(now()) @map("created_at")
  updatedAt      DateTime   @updatedAt @map("updated_at")

  lead           Lead       @relation(fields: [leadId], references: [id], onDelete: Cascade)
  orders         Order[]

  @@index([quotationNumber])
  @@map("quotations")
}

model Order {
  id             String      @id @default(uuid())
  orderNumber    String      @unique @map("order_number")
  quotationId    String      @map("quotation_id")
  totalAmount    Float       @map("total_amount")
  status         OrderStatus @default(DRAFT)

  createdAt      DateTime    @default(now()) @map("created_at")
  updatedAt      DateTime    @updatedAt @map("updated_at")

  quotation      Quotation   @relation(fields: [quotationId], references: [id], onDelete: Cascade)
  invoices       Invoice[]
  projects       Project[]

  @@index([orderNumber])
  @@map("orders")
}

model Invoice {
  id             String        @id @default(uuid())
  invoiceNumber  String        @unique @map("invoice_number")
  orderId        String        @map("order_id")
  subtotal       Float
  taxAmount      Float         @map("tax_amount")
  grandTotal     Float         @map("grand_total")
  paymentStatus  PaymentStatus @default(UNPAID)

  createdAt      DateTime      @default(now()) @map("created_at")
  updatedAt      DateTime      @updatedAt @map("updated_at")

  order          Order         @relation(fields: [orderId], references: [id], onDelete: Cascade)
  payments       Payment[]

  @@index([invoiceNumber])
  @@map("invoices")
}

model Payment {
  id             String   @id @default(uuid())
  invoiceId      String   @map("invoice_id")
  txnRefNumber   String   @unique @map("txn_ref_number")
  amountPaid     Float    @map("amount_paid")
  paymentMethod  String   @map("payment_method") // UPI, Bank Transfer, Card
  paidAt         DateTime @default(now()) @map("paid_at")

  invoice        Invoice  @relation(fields: [invoiceId], references: [id], onDelete: Cascade)

  @@map("payments")
}

model Commission {
  id             String   @id @default(uuid())
  partnerId      String   @map("partner_id")
  amount         Float
  commissionPct  Float    @map("commission_pct")
  isDisbursed    Boolean  @default(false) @map("is_disbursed")

  createdAt      DateTime @default(now()) @map("created_at")

  partner        Partner  @relation(fields: [partnerId], references: [id], onDelete: Cascade)

  @@map("commissions")
}

// ==========================================
// 6. PROJECTS, EXECUTION & SCADA
// ==========================================

model Project {
  id             String       @id @default(uuid())
  projectNumber  String       @unique @map("project_number")
  organizationId String       @map("organization_id")
  branchId       String?      @map("branch_id")
  customerId     String       @map("customer_id")
  orderId        String?      @map("order_id")
  managerId      String?      @map("manager_id")
  projectName    String       @map("project_name")
  systemCapacityKw Float      @map("system_capacity_kw")
  stage          ProjectStage @default(FEASIBILITY)

  createdAt      DateTime     @default(now()) @map("created_at")
  updatedAt      DateTime     @updatedAt @map("updated_at")
  deletedAt      DateTime?    @map("deleted_at")

  organization   Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  branch         Branch?      @relation(fields: [branchId], references: [id], onDelete: SetNull)
  customer       Customer     @relation(fields: [customerId], references: [id], onDelete: Cascade)
  order          Order?       @relation(fields: [orderId], references: [id], onDelete: SetNull)
  manager        User?        @relation("ProjectManagers", fields: [managerId], references: [id], onDelete: SetNull)

  telemetryLogs  Telemetry[]
  serviceTickets ServiceTicket[]

  @@index([projectNumber])
  @@index([stage])
  @@map("projects")
}

model Telemetry {
  id             String        @id @default(uuid())
  projectId      String        @map("project_id")
  type           TelemetryType
  metricValue    Float         @map("metric_value")
  unit           String        @default("kW")
  recordedAt     DateTime      @default(now()) @map("recorded_at")

  project        Project       @relation(fields: [projectId], references: [id], onDelete: Cascade)

  @@index([projectId, recordedAt])
  @@map("telemetry")
}

model ServiceTicket {
  id             String                @id @default(uuid())
  ticketNumber   String                @unique @map("ticket_number")
  customerId     String                @map("customer_id")
  projectId      String?               @map("project_id")
  subject        String
  priority       ServiceTicketPriority @default(MEDIUM)
  status         TicketStatus          @default(OPEN)

  createdAt      DateTime              @default(now()) @map("created_at")
  updatedAt      DateTime              @updatedAt @map("updated_at")

  customer       Customer              @relation(fields: [customerId], references: [id], onDelete: Cascade)
  project        Project?              @relation(fields: [projectId], references: [id], onDelete: SetNull)

  @@index([ticketNumber])
  @@map("service_tickets")
}

// ==========================================
// 7. SYSTEM AUDIT & NOTIFICATIONS
// ==========================================

model AuditLog {
  id             String   @id @default(uuid())
  userId         String?  @map("user_id")
  action         String
  resource       String
  ipAddress      String   @map("ip_address")
  userAgent      String   @map("user_agent")
  payloadJson    String?  @map("payload_json")
  createdAt      DateTime @default(now()) @map("created_at")

  user           User?    @relation(fields: [userId], references: [id], onDelete: SetNull)

  @@index([userId, createdAt])
  @@map("audit_logs")
}

model Notification {
  id             String   @id @default(uuid())
  userId         String   @map("user_id")
  title          String
  body           String
  isRead         Boolean  @default(false) @map("is_read")
  createdAt      DateTime @default(now()) @map("created_at")

  user           User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId, isRead])
  @@map("notifications")
}

model Activity {
  id           String    @id @default(uuid())
  customerId   String?   @map("customer_id")
  leadId       String?   @map("lead_id")
  userId       String?   @map("user_id")
  title        String
  description  String
  activityType String    @map("activity_type") // CALL, MEETING, WHATSAPP, EMAIL, NOTE, STAGE_CHANGE
  createdAt    DateTime  @default(now()) @map("created_at")

  customer     Customer? @relation(fields: [customerId], references: [id], onDelete: Cascade)
  lead         Lead?     @relation(fields: [leadId], references: [id], onDelete: Cascade)

  @@index([customerId, createdAt])
  @@index([leadId, createdAt])
  @@map("activities")
}

model PricingSheet {
  id                      String    @id @default(uuid())
  pricingCode             String    @unique @default(uuid()) @map("pricing_code")
  designId                String?   @map("design_id")
  leadId                  String?   @map("lead_id")
  customerId              String?   @map("customer_id")
  partnerId               String?   @map("partner_id")

  baseEquipmentCost       Float     @default(0.0) @map("base_equipment_cost")
  bosCost                 Float     @default(0.0) @map("bos_cost")
  installationCost        Float     @default(0.0) @map("installation_cost")
  civilCost               Float     @default(0.0) @map("civil_cost")
  electricalCost          Float     @default(0.0) @map("electrical_cost")
  transportCost           Float     @default(0.0) @map("transport_cost")

  marginAmount            Float     @default(0.0) @map("margin_amount")
  marginPercentage        Float     @default(0.0) @map("margin_percentage")
  discountAmount          Float     @default(0.0) @map("discount_amount")
  discountPercentage      Float     @default(0.0) @map("discount_percentage")

  subtotalAmount          Float     @default(0.0) @map("subtotal_amount")
  gstRate                 Float     @default(13.8) @map("gst_rate")
  gstAmount               Float     @default(0.0) @map("gst_amount")
  grossTotal              Float     @default(0.0) @map("gross_total")
  subsidyAmount           Float     @default(0.0) @map("subsidy_amount")
  netCustomerContribution Float     @default(0.0) @map("net_customer_contribution")

  status                  String    @default("DRAFT") @map("status")
  breakdownJson           String?   @map("breakdown_json")
  remarks                 String?   @map("remarks")

  createdAt               DateTime  @default(now()) @map("created_at")
  updatedAt               DateTime  @updatedAt @map("updated_at")
  deletedAt               DateTime? @map("deleted_at")

  @@map("pricing_sheets")
}

model Quotation {
  id                    String    @id @default(uuid())
  quotationNumber       String    @unique @default(uuid()) @map("quotation_number")
  version               String    @default("1.0") @map("version")
  parentQuotationId     String?   @map("parent_quotation_id")

  customerId            String?   @map("customer_id")
  leadId                String?   @map("lead_id")
  surveyId              String?   @map("survey_id")
  designId              String?   @map("design_id")
  pricingId             String?   @map("pricing_id")
  partnerId             String?   @map("partner_id")
  salesExecutiveId      String?   @map("sales_executive_id")

  status                String    @default("DRAFT") @map("status")

  systemCapacityKw      Float     @default(0.0) @map("system_capacity_kw")
  totalProjectCost      Float     @default(0.0) @map("total_project_cost")
  gstAmount             Float     @default(0.0) @map("gst_amount")
  subsidyAmount         Float     @default(0.0) @map("subsidy_amount")
  netCustomerPrice      Float     @default(0.0) @map("net_customer_price")

  proposalDataJson      String?   @map("proposal_data_json")
  termsAndConditions    String?   @map("terms_and_conditions")
  paymentTerms          String?   @map("payment_terms")
  warrantyDetails       String?   @map("warranty_details")
  pdfUrl                String?   @map("pdf_url")
  qrCodeUrl             String?   @map("qr_code_url")

  digitalSignatureJson  String?   @map("digital_signature_json")
  deliveryLogJson       String?   @map("delivery_log_json")
  remarks               String?   @map("remarks")

  createdAt             DateTime  @default(now()) @map("created_at")
  updatedAt             DateTime  @updatedAt @map("updated_at")
  deletedAt             DateTime? @map("deleted_at")

  @@map("quotations")
}

model Order {
  id              String    @id @default(uuid())
  orderNumber     String    @unique @default(uuid()) @map("order_number")
  quotationId     String?   @map("quotation_id")
  customerId      String?   @map("customer_id")
  leadId          String?   @map("lead_id")
  partnerId       String?   @map("partner_id")

  totalAmount     Float     @default(0.0) @map("total_amount")
  status          String    @default("CONFIRMED") @map("status")
  remarks         String?   @map("remarks")

  createdAt       DateTime  @default(now()) @map("created_at")
  updatedAt       DateTime  @updatedAt @map("updated_at")
  deletedAt       DateTime? @map("deleted_at")

  @@map("orders")
}

model Project {
  id                   String    @id @default(uuid())
  projectNumber        String    @unique @default(uuid()) @map("project_number")
  orderId              String?   @map("order_id")
  quotationId          String?   @map("quotation_id")
  customerId           String?   @map("customer_id")

  projectManagerId     String?   @map("project_manager_id")
  epcVendorId          String?   @map("epc_vendor_id")
  installationVendorId String?   @map("installation_vendor_id")
  surveyEngineerId     String?   @map("survey_engineer_id")

  stage                String    @default("ORDER_CONFIRMED") @map("stage")
  status               String    @default("IN_PROGRESS") @map("status")
