    {
      "name": "Create System Incident",
      "request": {
        "method": "POST",
        "header": [{ "key": "Content-Type", "value": "application/json" }],
        "body": {
          "mode": "raw",
          "raw": "{\n  \"title\": \"PostgreSQL Connection Pool Exhaustion on SCADA Gateway Ingest\",\n  \"severity\": \"SEV-2\",\n  \"category\": \"DATABASE\",\n  \"assignedLead\": \"Vikram Mehta (Principal SRE)\",\n  \"impactedTenants\": \"ORG-CUST-102 (Gujarat Solar Parks)\"\n}"
        },
        "url": {
          "raw": "{{baseUrl}}/api/v1/operations/incidents",
          "host": ["{{baseUrl}}"],
          "path": ["api", "v1", "operations", "incidents"]
        }
      }
    },
    {
      "name": "Update System Incident",
      "request": {
        "method": "PUT",
        "header": [{ "key": "Content-Type", "value": "application/json" }],
        "body": {
          "mode": "raw",
          "raw": "{\n  \"status\": \"MITIGATED\",\n  \"resolutionNotes\": \"Increased max_connections to 200 and restarted connection pool proxy.\"\n}"
        },
        "url": {
          "raw": "{{baseUrl}}/api/v1/operations/incidents/INC-2026-801",
          "host": ["{{baseUrl}}"],
          "path": ["api", "v1", "operations", "incidents", "INC-2026-801"]
